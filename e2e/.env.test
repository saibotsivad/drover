# E2E test environment.
#
# These values are intentionally committed: this configuration only ever
# runs against throwaway local/CI Drover stacks built by
# docker-compose.e2e.yml.
#
# DROVER_API_KEY here is the plain-text key sent over HTTP. The matching
# SHA-256 hex digest is hard-coded into docker-compose.e2e.yml under the
# orchestrator's DROVER_API_KEY environment variable.

# Plain-text API key used by the test scripts in the Authorization header.
DROVER_API_KEY=drover-e2e-test-key

# Service endpoints exposed by docker-compose.e2e.yml.
ORCHESTRATOR_URL=http://localhost:8000
WEBAPP_URL=http://localhost:9091

# Container names — used for `docker logs` capture.
ORCHESTRATOR_CONTAINER=drover-e2e-orchestrator
WEBAPP_CONTAINER=drover-e2e-webapp

# Image tags built by docker-compose.e2e.yml.
ORCHESTRATOR_IMAGE=drover-orchestrator:e2e
WEBAPP_IMAGE=drover-webapp:e2e
BUILDER_IMAGE=drover-builder:e2e

# Host directory bind-mounted into the orchestrator container at
# /var/run/microcontainers. The orchestrator hands this host-side path to
# the Docker daemon when it mounts per-container sockets into builders.
DROVER_SOCKET_DIR=/tmp/drover-sockets
